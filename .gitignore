# Dependencies (a bundle never commits its lock file)
/vendor/
/vendor-bin/*/vendor/
/vendor-bin/*/composer.lock
/composer.lock

# Caches, reports and test artefacts
/var/
/.phpunit.cache/
/.phpunit.result.cache
/.php-cs-fixer.cache
/infection.log

# Local overrides of the distributed configurations
/phpunit.xml
/phpstan.neon
/.php-cs-fixer.php
/phpmd.xml
/infection.json5.local

# IDE and OS
/.idea/
/.vscode/
.DS_Store
